import { useState, useMemo, useRef, useEffect, useCallback, type ReactNode } from 'react'
import { motion, AnimatePresence } from 'framer-motion'
import { Plus, Trash2, Search, Upload, FileSpreadsheet, Download, X, Check, AlertCircle, ChevronDown, Eye, FileText, Settings, ArrowLeft, ArrowRight, Copy, ExternalLink, CheckCircle } from 'lucide-react'
import { useApp } from '@/lib/appStore'
import { formatCurrency, formatDate } from '@/lib/format'
import { Select } from '@/components/ui/Select'
import { Modal, Field, inputCls } from '@/components/ui/Modal'
import DocumentManager from '@/components/ui/DocumentManager'
import { parseFile, parseCsvText, autoMapHeaders, createImportPreview, downloadTemplate, mapRowToTransaction, type ParsedFile, type ImportColumnMapping, type ImportPreview, type ImportRow, IMPORTABLE_FIELDS, SOURCE_TYPE_OPTIONS, PAYMENT_METHOD_OPTIONS } from '@/lib/importUtils'
import { getTransactions, createTransaction, updateTransaction, deleteTransaction, bulkCreateTransactions, getCategories, checkDuplicateTransactions } from '@/lib/dataService'
import type { Transaction, TransactionFormData, DocumentStatus, Category, TxType } from '@/lib/types'

type Tab = 'list' | 'add' | 'import'
type SortDir = 'asc' | 'desc'

const emptyForm = (): TransactionFormData => ({
  transaction_date: new Date().toISOString().slice(0, 16),
  type: 'income',
  amount: 0,
  currency: 'RUB',
  description: '',
  category_id: null,
  sender_name: '',
  sender_bank: '',
  sender_account_masked: '',
  recipient_name: '',
  recipient_bank: '',
  recipient_account_masked: '',
  source_type: null,
  comment: '',
  document_name: '',
  document_path: '',
  document_status: 'missing',
  bank_transaction_id: '',
  payment_method: null,
  is_public: true,
})

function parseAmount(val: string): number {
  return Number(String(val).replace(/\s/g, '').replace(',', '.'))
}

interface AddTabProps {
  addForm: TransactionFormData
  setAddForm: React.Dispatch<React.SetStateAction<TransactionFormData>>
  addErrors: Record<string, boolean>
  setAddErrors: React.Dispatch<React.SetStateAction<Record<string, boolean>>>
  categories: Category[]
  handleAddSubmit: () => void
  handleAddAndAnother: () => void
  validateForm: () => boolean
  t: ReturnType<typeof import('@/lib/appStore').useApp>['t']
  saving?: boolean
  feedback?: { type: 'success' | 'error'; text: string } | null
}

function AddTab({
  addForm,
  setAddForm,
  addErrors,
  setAddErrors,
  categories,
  handleAddSubmit,
  handleAddAndAnother,
  validateForm,
  t,
  saving = false,
  feedback = null,
}: AddTabProps) {
  return (
    <div className="space-y-4 max-w-2xl mx-auto">
      <div className="text-center py-4">
        <div className="text-sm font-medium text-text">{t.addTab}</div>
        <div className="mt-1 text-sm text-muted">{t.operationsSub}</div>
      </div>

      <div className="rounded-xl border border-border/70 bg-card/30 p-5 space-y-4">
        {/* Type selector */}
        <div className="grid grid-cols-2 gap-2">
          <button
            type="button"
            onClick={() => setAddForm((f) => ({ ...f, type: 'income' }))}
            className={`rounded-xl border p-3 text-sm font-medium transition ${
              addForm.type === 'income'
                ? 'border-accent/40 bg-accent/10 text-accent'
                : 'border-border bg-cardAlt/50 text-muted hover:text-text hover:border-border/80'
            }`}
          >
            <div className="flex items-center justify-center gap-2"><span className="text-xl">+</span> {t.incomeLabel}</div>
          </button>
          <button
            type="button"
            onClick={() => setAddForm((f) => ({ ...f, type: 'expense' }))}
            className={`rounded-xl border p-3 text-sm font-medium transition ${
              addForm.type === 'expense'
                ? 'border-red-500/40 bg-red-500/10 text-red-400'
                : 'border-border bg-cardAlt/50 text-muted hover:text-text hover:border-border/80'
            }`}
          >
            <div className="flex items-center justify-center gap-2"><span className="text-xl">−</span> {t.expenseLabel}</div>
          </button>
        </div>

        {/* Category (purpose) */}
        <Field label={t.category}>
          <Select
            value={addForm.category_id || ''}
            options={[{ value: '', label: 'Не выбрана категория' }, ...categories
              .filter(c => c.type === addForm.type && c.is_active)
              .map(c => ({ value: c.id, label: c.name }))]}
            onChange={(v) => setAddForm((f) => ({ ...f, category_id: v || null }))}
            ariaLabel={t.category}
            className={addErrors.category_id ? 'border-red-500/50' : ''}
          />
          {categories.filter(c => c.type === addForm.type && c.is_active).length === 0 && (
            <div className="mt-1 text-xs text-muted">
              РљР°С‚РµРіРѕСЂРёР№ Р Р…Р ВµРЎвЂљ — СЃРѕР·РґР°Р№С‚Рµ РІ СЂР°Р·РґРµР»Рµ <span className="text-accent">РќР°СЃС‚СЂРѕР№РєРё</span>
            </div>
          )}
          {addErrors.category_id && <div className="mt-1 text-xs text-red-400">{t.categoryRequired}</div>}
        </Field>

        {/* Amount & Currency */}
        <div className="grid grid-cols-2 gap-2">
          <Field label={t.amount}>
            <input
              type="number"
              step="0.01"
              min="0.01"
              value={addForm.amount || ''}
              onChange={(e) => setAddForm((f) => ({ ...f, amount: parseAmount(e.target.value) }))}
              className={`${inputCls} ${addErrors.amount ? 'border-red-500/50' : ''}`}
              placeholder="0.00"
            />
            {addErrors.amount && <div className="mt-1 text-xs text-red-400">{t.amountRequired}</div>}
          </Field>
          <Field label={t.currency}>
            <Select value={addForm.currency} options={[
              { value: 'RUB', label: 'RUB (₽)' },
              { value: 'USD', label: 'USD ($)' },
              { value: 'EUR', label: 'EUR (€)' },
            ]} onChange={(v) => setAddForm((f) => ({ ...f, currency: v }))} />
          </Field>
        </div>

        {/* Date */}
        <Field label={t.date}>
          <input
            type="datetime-local"
            value={addForm.transaction_date}
            onChange={(e) => setAddForm((f) => ({ ...f, transaction_date: e.target.value }))}
            className={inputCls}
          />
        </Field>

        {/* Sender/Donor name */}
        <Field label={addForm.type === 'income' ? 'Р В�Р С�РЎРЏ РґРѕРЅРѕСЂР°' : 'Р СџР С•Р В»РЎС“РЎвЂЎР В°РЎвЂљР ВµР В»РЎРЉ'}>
          <input
            value={addForm.type === 'income' ? addForm.sender_name : addForm.recipient_name}
            onChange={(e) => setAddForm((f) => ({
              ...f,
              [addForm.type === 'income' ? 'sender_name' : 'recipient_name']: e.target.value
            }))}
            className={inputCls}
            placeholder={addForm.type === 'income' ? 'Р В�РІР°РЅРѕРІ Р В�РІР°РЅ / Р С›Р С›Р С› Р РѕРјР°С€РєР°' : 'Р С›Р С›Р С› Р РѕРјР°С€РєР° / Р В�РІР°РЅРѕРІ Р В�РІР°РЅ'}
          />
        </Field>

        {/* Description - purpose */}
        <Field label={t.description}>
          <textarea
            value={addForm.description}
            onChange={(e) => setAddForm((f) => ({ ...f, description: e.target.value }))}
            className={inputCls}
            rows={2}
            placeholder={addForm.type === 'income' ? 'РќР°Р·РЅР°С‡РµРЅРёРµ РїРѕР¶РµСЂС‚РІРѕРІР°РЅРёСЏ (Р Р…Р В° РЎвЂЎРЎвЂљР С• РѕС‚РїСЂР°РІР»РµРЅРѕ)' : 'Р СњР В° РЎвЂЎРЎвЂљР С• РїРѕС‚СЂР°С‡РµРЅРѕ'}
          />
        </Field>

        {/* Status */}
        <Field label="Р РЋРЎвЂљР В°РЎвЂљРЎС“РЎРѓ">
          <Select
            value={addForm.document_status}
            options={[
              { value: 'attached', label: 'Р”РѕРєСѓРјРµРЅС‚ РїСЂРёРєСЂРµРїР»С‘РЅ' },
              { value: 'expected', label: 'Р”РѕРєСѓРјРµРЅС‚ Р С•Р В¶Р С‘Р Т‘Р В°Р ВµРЎвЂљРЎРѓРЎРЏ' },
              { value: 'missing', label: 'Р”РѕРєСѓРјРµРЅС‚Р° Р Р…Р ВµРЎвЂљ' },
            ]}
            onChange={(v) => setAddForm((f) => ({ ...f, document_status: v as DocumentStatus }))}
          />
        </Field>

        {/* Source type (for income) */}
        {addForm.type === 'income' && (
          <Field label="Р В�РЎРѓРЎвЂљР С•РЎвЂЎР Р…Р С‘Р С” РїРѕСЃС‚СѓРїР»РµРЅРёСЏ">
            <Select
              value={addForm.source_type || ''}
              options={[{ value: '', label: 'Р СњР Вµ СѓРєР°Р·Р°РЅ' }, ...SOURCE_TYPE_OPTIONS]}
              onChange={(v) => setAddForm((f) => ({ ...f, source_type: v || null }))}
            />
          </Field>
        )}

        {/* Payment method */}
        <Field label="Способ оплаты способа оплаты">
          <Select
            value={addForm.payment_method || ''}
            options={[{ value: '', label: 'Р СњР Вµ СѓРєР°Р·Р°РЅ' }, ...PAYMENT_METHOD_OPTIONS]}
            onChange={(v) => setAddForm((f) => ({ ...f, payment_method: v || null }))}
          />
        </Field>

        {/* Public checkbox */}
        <label className="flex items-center gap-2 cursor-pointer text-sm text-muted">
          <input
            type="checkbox"
            checked={addForm.is_public}
            onChange={(e) => setAddForm((f) => ({ ...f, is_public: e.target.checked }))}
            className="h-4 w-4 rounded border-border bg-card text-accent focus:ring-accent"
          />
          <Eye size={14} /> РћРїСѓР±Р»РёРєРѕРІР°С‚СЊ Р Р…Р В° СЃС‚СЂР°РЅРёС†Рµ РїСЂРѕР·СЂР°С‡РЅРѕСЃС‚Рё
        </label>

        {feedback && (
          <div
            className={`rounded-xl border px-3 py-2 text-sm ${
              feedback.type === 'success'
                ? 'border-accent/30 bg-accent/10 text-accent'
                : 'border-red-500/30 bg-red-500/10 text-red-400'
            }`}
          >
            {feedback.text}
          </div>
        )}

        {Object.keys(addErrors).length > 0 && (
          <div className="rounded-xl border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-400">
            Р—Р°РїРѕР»РЅРёС‚Рµ Р С•Р В±РЎРЏР В·Р В°РЎвЂљР ВµР В»РЎРЉР Р…РЎвЂ№Р Вµ РїРѕР»СЏ: РєР°С‚РµРіРѕСЂРёСЏ, РЎРѓРЎС“Р С�Р С�Р В° Рё РґР°С‚Р°.
          </div>
        )}

        {/* Actions */}
        <div className="flex gap-2 pt-2 justify-end">
          <button
            type="button"
            onClick={handleAddAndAnother}
            disabled={saving}
            className="rounded-xl border border-border bg-cardAlt/60 px-4 py-2.5 text-sm font-medium text-muted transition hover:text-text hover:border-border/80 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            {saving ? 'Р РЋР С•РЎвЂ¦РЎР‚Р В°Р Р…Р ВµР Р…Р С‘Р Вµ...' : t.saveAndAddAnother}
          </button>
          <button
            type="button"
            onClick={handleAddSubmit}
            disabled={saving}
            className="rounded-xl border border-accent/30 bg-accent/15 px-4 py-2.5 text-sm font-medium text-accent transition hover:bg-accent/20 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            {saving ? 'Р РЋР С•РЎвЂ¦РЎР‚Р В°Р Р…Р ВµР Р…Р С‘Р Вµ...' : t.save}
          </button>
        </div>
      </div>
    </div>
  )
}

export default function OperationsPage({ initialTxType, setInitialTxType }: { initialTxType?: TxType | null; setInitialTxType?: (t: TxType) => void }) {
  const { t, currency, locale } = useApp()
  const [activeTab, setActiveTab] = useState<Tab>('list')
  const [rows, setRows] = useState<Transaction[]>([])
  const [loading, setLoading] = useState(true)
  const [q, setQ] = useState('')
  const [typeFilter, setTypeFilter] = useState<'all' | TxType>('all')
  const [categoryFilter, setCategoryFilter] = useState<string>('all')
  const [sortCol, setSortCol] = useState<keyof Transaction>('transaction_date')
  const [sortDir, setSortDir] = useState<SortDir>('desc')
  const [categories, setCategories] = useState<Category[]>([])
  const [selectedRow, setSelectedRow] = useState<Transaction | null>(null)

  // Add modal state
  const [showAddModal, setShowAddModal] = useState(false)
  const [addForm, setAddForm] = useState<TransactionFormData>(emptyForm())
  const [addErrors, setAddErrors] = useState<Record<string, boolean>>({})
  const [addSaving, setAddSaving] = useState(false)
  const [addFeedback, setAddFeedback] = useState<{ type: 'success' | 'error'; text: string } | null>(null)

  // Import state
  const [importFile, setImportFile] = useState<File | null>(null)
  const [parsedFile, setParsedFile] = useState<ParsedFile | null>(null)
  const [importMapping, setImportMapping] = useState<ImportColumnMapping[]>([])
  const [importPreview, setImportPreview] = useState<ImportPreview | null>(null)
  const [importStage, setImportStage] = useState<'upload' | 'mapping' | 'preview' | 'confirm'>('upload')
  const [importMsg, setImportMsg] = useState('')
  const fileInputRef = useRef<HTMLInputElement>(null)

  // Open add modal with pre-selected type from dashboard quick actions
  useEffect(() => {
    if (initialTxType) {
      openAddModal(initialTxType)
      setInitialTxType?.(null)
    }
  }, [initialTxType])

  // Load initial data
  const loadData = useCallback(async () => {
    setLoading(true)
    try {
      const [txns, cats] = await Promise.all([
        getTransactions(undefined, { limit: 500 }),
        getCategories()
      ])
      console.log('[OperationsPage] Loaded categories:', cats.length, cats.map(c => c.name))
      setRows(txns.data)
      setCategories(cats)
    } catch (e) {
      console.error('Failed to load data:', e)
      // Show empty state instead of demo data
      setRows([])
      setCategories([])
    } finally {
      setLoading(false)
    }
  }, [])

  useEffect(() => { loadData() }, [loadData])

  // Filter & sort
  const filtered = useMemo(() => {
    let result = rows
    if (typeFilter !== 'all') result = result.filter((r) => r.type === typeFilter)
    if (categoryFilter !== 'all') result = result.filter((r) => r.category_id === categoryFilter)
    if (q) {
      const qq = q.toLowerCase()
      result = result.filter((r) =>
        `${r.description} ${r.category_id || ''} ${r.sender_name || ''} ${r.recipient_name || ''} ${r.bank_transaction_id || ''}`.toLowerCase().includes(qq)
      )
    }
    result = [...result].sort((a, b) => {
      const av = a[sortCol] ?? ''
      const bv = b[sortCol] ?? ''
      if (av < bv) return sortDir === 'asc' ? -1 : 1
      if (av > bv) return sortDir === 'asc' ? 1 : -1
      return 0
    })
    return result
  }, [rows, q, typeFilter, categoryFilter, sortCol, sortDir])

  const handleSort = (col: keyof Transaction) => {
    if (sortCol === col) setSortDir((d) => (d === 'asc' ? 'desc' : 'asc'))
    else { setSortCol(col); setSortDir('desc') }
  }

  const updateRow = (id: string, patch: Partial<Transaction>) =>
    setRows((prev) => prev.map((r) => (r.id === id ? { ...r, ...patch } : r)))

const handleDelete = async (id: string) => {
    if (!confirm(t.confirmDelete)) return
    try {
      await deleteTransaction(id)
      setRows((prev) => prev.filter((r) => r.id !== id))
    } catch (e) {
      console.error('Delete error:', e)
      const errorMessage = e instanceof Error ? e.message : 'Ошибка РїСЂРё РЎС“Р Т‘Р°Р»РµРЅРёРё'
      alert(errorMessage)
    }
  }

  const handleTogglePublic = async (id: string, current: boolean) => {
    try {
      const { updateTransaction } = await import('@/lib/dataService')
      await updateTransaction(id, { is_public: !current } as any)
      setRows((prev) => prev.map((r) => r.id === id ? { ...r, is_public: !current } : r))
    } catch (e) {
      console.error('Toggle public error:', e)
      const errorMessage = e instanceof Error ? e.message : 'Ошибка РїСЂРё РёР·РјРµРЅРµРЅРёРё'
      alert(errorMessage)
    }
  }

  // --- ADD MODAL ---
  // --- ADD MODAL ---
  const openAddModal = (type?: TxType) => {
    const newForm = emptyForm()
    if (type) newForm.type = type
    setAddForm(newForm)
    setAddErrors({})
    setAddFeedback(null)
    setShowAddModal(true)
  }

  const validateForm = (): boolean => {
    const errors: Record<string, boolean> = {}
    if (!addForm.category_id) errors.category_id = true
    if (!addForm.amount || Number.isNaN(addForm.amount)) errors.amount = true
    if (!addForm.transaction_date) errors.transaction_date = true
    setAddErrors(errors)
    return Object.keys(errors).length === 0
  }

  const handleAddSubmit = async () => {
    if (addSaving) return
    if (!validateForm()) {
      setAddFeedback({ type: 'error', text: 'Р—Р°РїРѕР»РЅРёС‚Рµ РѕР±СЏР·Р°С‚РµР»СЊРЅС‹Рµ РїРѕР»СЏ: РєР°С‚РµРіРѕСЂРёСЏ, СЃСѓРјРјР° Рё РґР°С‚Р°.' })
      return
    }
    setAddSaving(true)
    setAddFeedback(null)
    try {
      const newTx = await createTransaction(addForm)
      setRows((prev) => [newTx, ...prev])
      setAddForm(emptyForm())
      setAddErrors({})
      setAddFeedback({ type: 'success', text: 'РћРїРµСЂР°С†РёСЏ СЃРѕС…СЂР°РЅРµРЅР°' })
    } catch (e) {
      console.error('Create error:', e)
      const errorMessage = e instanceof Error ? e.message : 'Ошибка РїСЂРё СЃРѕС…СЂР°РЅРµРЅРёРё'
      setAddFeedback({ type: 'error', text: errorMessage })
    } finally {
      setAddSaving(false)
    }
  }

  const handleAddAndAnother = async () => {
    if (addSaving) return
    if (!validateForm()) {
      setAddFeedback({ type: 'error', text: 'Р—Р°РїРѕР»РЅРёС‚Рµ РѕР±СЏР·Р°С‚РµР»СЊРЅС‹Рµ РїРѕР»СЏ: РєР°С‚РµРіРѕСЂРёСЏ, СЃСѓРјРјР° Рё РґР°С‚Р°.' })
      return
    }
    setAddSaving(true)
    setAddFeedback(null)
    try {
      const newTx = await createTransaction(addForm)
      setRows((prev) => [newTx, ...prev])
      setAddForm({ ...emptyForm(), type: addForm.type })
      setAddErrors({})
      setAddFeedback({ type: 'success', text: 'РћРїРµСЂР°С†РёСЏ СЃРѕС…СЂР°РЅРµРЅР°. РњРѕР¶РЅРѕ РґРѕР±Р°РІРёС‚СЊ СЃР»РµРґСѓСЋС‰СѓСЋ.' })
    } catch (e) {
      console.error('Create error:', e)
      const errorMessage = e instanceof Error ? e.message : 'Ошибка РїСЂРё СЃРѕС…СЂР°РЅРµРЅРёРё'
      setAddFeedback({ type: 'error', text: errorMessage })
    } finally {
      setAddSaving(false)
    }
  }

  // --- IMPORT ---
  const pickFile = () => fileInputRef.current?.click()

  const handleFileSelect = async (file: File) => {
    setImportFile(file)
    setImportMsg('')
    setImportStage('mapping')
    try {
      const parsed = file.name.endsWith('.csv') ? await parseCsvText(await file.text()) : await parseFile(file)
      setParsedFile(parsed)
      setImportMapping(autoMapHeaders(parsed.headers))
    } catch (e) {
      console.error('Parse error:', e)
      setImportMsg('Ошибка РїСЂРё С‡С‚РµРЅРёРё РЎвЂћР В°Р в„–Р В»Р В°')
      setImportStage('upload')
    }
  }

  const updateMapping = (sourceColumn: string, targetField: ImportColumnMapping['targetField']) => {
    setImportMapping(prev => prev.map(m => m.sourceColumn === sourceColumn ? { ...m, targetField } : m))
    updatePreview()
  }

  const updatePreview = async () => {
    if (!parsedFile) return
    try {
      const existingBankIds = await checkDuplicateTransactions([])
      const preview = createImportPreview(parsedFile, importMapping, categories.map(c => ({ id: c.id, name: c.name })), existingBankIds)
      setImportPreview(preview)
      setImportStage('preview')
    } catch (e) {
      console.error('Preview error:', e)
    }
  }

  const confirmImport = async () => {
    if (!importPreview) return
    const validRows = importPreview.rows
      .filter(r => r.validation.isValid && !r.isDuplicate)
      .map(r => r.mapped)
    if (!validRows.length) { setImportMsg('Р СњР ВµРЎвЂљ Р Р†Р В°Р В»Р С‘Р Т‘Р Р…РЎвЂ№РЎвЂ¦ СЃС‚СЂРѕРє РґР»СЏ РёРјРїРѕСЂС‚Р°'); return }

    setImportStage('confirm')
    setImportMsg('Р В�РјРїРѕСЂС‚...')
    try {
      const newTxs = await bulkCreateTransactions(validRows)
      setRows((prev) => [...newTxs, ...prev])
      setImportMsg(`РЈСЃРїРµС€РЅРѕ РёРјРїРѕСЂС‚РёСЂРѕРІР°РЅРѕ ${newTxs.length} РѕРїРµСЂР°С†РёР№`)
      setTimeout(() => { resetImport(); setImportMsg('') }, 2000)
    } catch (e) {
      console.error('Import error:', e)
      const errorMessage = e instanceof Error ? e.message : 'Ошибка РїСЂРё РёРјРїРѕСЂС‚Рµ'
      setImportMsg(errorMessage)
      // Go back to preview stage to show error
      setImportStage('preview')
    }
  }

  const resetImport = () => {
    setImportFile(null)
    setParsedFile(null)
    setImportMapping([])
    setImportPreview(null)
    setImportStage('upload')
    setImportMsg('')
    if (fileInputRef.current) fileInputRef.current.value = ''
  }

  // --- TABS ---
  const tabs = [
    { id: 'list' as Tab, label: t.tabs.list, icon: (props: any) => <FileText {...props} /> },
    { id: 'add' as Tab, label: t.tabs.add, icon: Plus },
    { id: 'import' as Tab, label: t.tabs.import, icon: Upload },
  ]

  // --- RENDER FUNCTIONS ---
  const ListTab = () => (
    <div className="space-y-3">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div className="text-sm text-muted">{t.operationsSub}</div>
        <div className="flex flex-wrap items-center gap-2">
          <div className="flex items-center gap-2 rounded-lg border border-border/70 bg-card/30 px-3 py-2 text-sm text-muted">
            <Search size={15} />
            <input value={q} onChange={(e) => setQ(e.target.value)} placeholder={t.search} className="w-48 bg-transparent text-text outline-none placeholder:text-muted/70" />
          </div>
          <Select value={typeFilter} options={[
            { value: 'all' as const, label: t.filterAll },
            { value: 'income' as const, label: t.filterIncome },
            { value: 'expense' as const, label: t.filterExpense },
          ]} onChange={(v) => setTypeFilter(v)} ariaLabel={t.type} className="w-40" />
          <Select value={categoryFilter} options={[
            { value: 'all', label: 'Р вЂ™РЎРѓР Вµ РєР°С‚РµРіРѕСЂРёРё' },
            ...categories.map(c => ({ value: c.id, label: c.name })),
          ]} onChange={(v) => setCategoryFilter(v)} ariaLabel={t.category} className="w-48" />
        </div>
      </div>

      <motion.div className="overflow-hidden rounded-xl border border-border/70 bg-card/20">
        <div className="overflow-x-auto">
          <table className="w-full min-w-[1200px] border-collapse text-sm">
            <thead className="bg-cardAlt/40 text-left text-xs text-muted">
              <tr>
                {[
                  { key: 'transaction_date', label: t.date },
                  { key: 'type', label: t.type },
                  { key: 'category_id', label: t.category },
                  { key: 'description', label: t.description },
                  { key: 'sender_name', label: 'РћС‚РїСЂР°РІРёС‚РµР»СЊ' },
                  { key: 'source_type', label: 'Р В�РЎРѓРЎвЂљР С•РЎвЂЎР Р…Р С‘Р С”' },
                  { key: 'amount', label: `${t.amount} (${currency})` },
                  { key: 'payment_method', label: 'Способ оплаты' },
                ].map((col) => (
                  <th
                    key={col.key}
                    className="border-b border-border/60 px-3 py-2.5 font-medium cursor-pointer hover:text-text select-none"
                    onClick={() => handleSort(col.key as keyof Transaction)}
                  >
                    <div className="flex items-center gap-1">
                      {col.label}
                      {sortCol === col.key && (
                        <ChevronDown size={12} className={sortDir === 'asc' ? 'rotate-180' : ''} />
                      )}
                    </div>
                  </th>
                ))}
                <th className="w-16 border-b border-border/60 px-2 py-2.5 text-center">
                  <Eye size={14} className="text-muted mx-auto" />
                </th>
                <th className="w-12 border-b border-border/60 px-2 py-2.5"></th>
              </tr>
            </thead>
            <tbody>
              {filtered.length === 0 ? (
                <tr><td colSpan={9} className="px-4 py-10 text-center text-muted">{t.empty}</td></tr>
              ) : filtered.map((r) => {
                const cat = categories.find(c => c.id === r.category_id)
                return (
                  <tr key={r.id} className="group hover:bg-cardAlt/20" onClick={() => setSelectedRow(r)}>
                    <td className="border-b border-border/50 px-3 py-2.5 text-text">{formatDate(r.transaction_date, locale)}{r.transaction_date.includes('T') ? `, ${r.transaction_date.slice(11, 16)}` : ''}</td>
                    <td className="border-b border-border/50 px-3 py-2.5">
                      <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs ${
                        r.type === 'income' ? 'bg-accent/15 text-accent' : 'bg-red-500/15 text-red-400'
                      }`}>
                        {r.type === 'income' ? 'РІвЂ вЂ�' : 'РІвЂ вЂњ'} {r.type === 'income' ? t.incomeLabel : t.expenseLabel}
                      </span>
                    </td>
                    <td className="border-b border-border/50 px-3 py-2.5 text-muted">{cat?.name || r.category_id || '—'}</td>
                    <td className="border-b border-border/50 px-3 py-2.5 text-text truncate max-w-xs">{r.description || '—'}</td>
                    <td className="border-b border-border/50 px-3 py-2.5 text-muted truncate max-w-xs">{r.sender_name || r.recipient_name || '—'}</td>
                    <td className="border-b border-border/50 px-3 py-2.5 text-muted">
                      {r.source_type && (
                        <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-blue-500/15 text-blue-400">
                          {SOURCE_TYPE_OPTIONS.find(o => o.value === r.source_type)?.label || r.source_type}
                        </span>
                      )}
                    </td>
                    <td className="border-b border-border/50 px-3 py-2.5 text-right font-medium">
                      {r.type === 'income' ? '+' : '-'}{formatCurrency(r.amount, currency, locale)}
                    </td>
                    <td className="border-b border-border/50 px-3 py-2.5 text-center text-muted">
                      {r.payment_method && (
                        <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-blue-500/15 text-blue-400">
                          {PAYMENT_METHOD_OPTIONS.find(o => o.value === r.payment_method)?.label || r.payment_method}
                        </span>
                      )}
                    </td>
                    <td className="border-b border-border/50 px-3 py-2.5 text-center">
                      <button
                        type="button"
                        onClick={(e) => { e.stopPropagation(); handleTogglePublic(r.id, r.is_public) }}
                        className={`relative inline-flex h-5 w-9 items-center rounded-full transition ${
                          r.is_public ? 'bg-accent' : 'bg-border'
                        }`}
                        aria-checked={r.is_public}
                        role="switch"
                        aria-label="РџСѓР±Р»РёС‡РЅР°СЏ РїСѓР±Р»РёРєР°С†РёСЏ"
                      >
                        <span className={`inline-block h-3 w-3 transform rounded-full bg-white transition ${
                          r.is_public ? 'translate-x-5' : 'translate-x-1'
                        }`} />
                      </button>
                    </td>
                    <td className="border-b border-border/50 px-2 py-2.5 text-center">
                      <button
                        type="button"
                        onClick={(e) => { e.stopPropagation(); handleDelete(r.id) }}
                        className="rounded p-1.5 text-muted opacity-60 transition hover:bg-cardAlt hover:text-text hover:opacity-100"
                        aria-label={t.delete}
                      >
                        <Trash2 size={14} />
                      </button>
                    </td>
                  </tr>
                )
              })}
            </tbody>
          </table>
        </div>
      </motion.div>
      <div className="text-[11px] text-muted">
        {t.balancePeriod}: {formatCurrency(
          filtered.reduce((s, r) => s + (r.type === 'income' ? r.amount : -r.amount), 0),
          currency,
          locale
        )}
      </div>
    </div>
  )

  const ImportTab = () => (
    <div className="space-y-4">
      {/* Stage 1: Upload */}
      {importStage === 'upload' && (
        <div className="rounded-xl border border-border bg-card p-5 shadow-card">
          <div className="text-base font-semibold text-text">{t.importFile}</div>
          <div className="mt-1 text-sm text-muted">{t.operationsSub}</div>
          <div className="mt-4 flex flex-wrap items-center gap-2">
            <button type="button" onClick={pickFile} className="inline-flex items-center gap-2 rounded-xl border border-accent/30 bg-accent/15 px-4 py-2.5 text-sm font-medium text-accent transition hover:bg-accent/20">
              <Upload size={16} /> {t.importFile}
            </button>
            <input ref={fileInputRef} type="file" accept=".csv,.xlsx,.xls" onChange={(e) => e.target.files?.[0] && handleFileSelect(e.target.files[0])} className="hidden" />
            <button type="button" onClick={() => downloadTemplate()} className="inline-flex items-center gap-2 rounded-xl border border-border bg-cardAlt/60 px-4 py-2.5 text-sm text-muted transition hover:text-text">
              <Download size={16} /> {t.downloadTemplate}
            </button>
          </div>
          <div className="mt-3 flex items-center gap-2 text-xs text-muted"><FileSpreadsheet size={14} /> {importFile ? `${t.fileLoaded}: ${importFile.name}` : t.noFile}</div>
          {importMsg && <div className="mt-3 rounded-xl border border-accent/20 bg-accent/10 px-3 py-2 text-sm text-accent">{importMsg}</div>}
        </div>
      )}

      {/* Stage 2: Column Mapping */}
      {importStage === 'mapping' && parsedFile && (
        <div className="rounded-xl border border-border bg-card p-5 shadow-card">
          <div className="flex flex-wrap items-center justify-between gap-2 mb-4">
            <div>
              <div className="text-sm font-medium text-text">Р РЋР С•Р С—Р С•РЎРѓРЎвЂљР В°Р Р†Р В»Р ВµР Р…Р С‘Р Вµ СЃС‚РѕР»Р±С†РѕРІ</div>
              <div className="text-xs text-muted">Р СњР В°РЎРѓРЎвЂљРЎР‚Р С•Р в„–РЎвЂљР Вµ СЃРѕРѕС‚РІРµС‚СЃС‚РІРёРµ СЃС‚РѕР»Р±С†РѕРІ РІР°С€РµРіРѕ РЎвЂћР В°Р в„–Р В»Р В° РїРѕР»СЏРј СЃРёСЃС‚РµРјС‹</div>
            </div>
            <button type="button" onClick={updatePreview} className="rounded-xl border border-accent/30 bg-accent/15 px-4 py-2 text-sm font-medium text-accent transition hover:bg-accent/20">Р СџРЎР‚Р ВµР Т‘РїСЂРѕСЃРјРѕС‚СЂ</button>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full min-w-[800px] text-sm">
              <thead className="bg-cardAlt/40 text-left text-xs text-muted">
                <tr>
                  <th className="px-3 py-2 font-medium">Р РЋРЎвЂљР С•Р В»Р В±Р ВµРЎвЂ  РЎвЂћР В°Р в„–Р В»Р В°</th>
                  <th className="px-3 py-2 font-medium">РџСЂРёРјРµСЂ Р·РЅР°С‡РµРЅРёСЏ</th>
                  <th className="px-3 py-2 font-medium">Р СџР С•Р В»Р Вµ СЃРёСЃС‚РµРјС‹</th>
                </tr>
              </thead>
              <tbody>
                {parsedFile.headers.map((h) => (
                  <tr key={h} className="border-t border-border/70">
                    <td className="px-3 py-2 font-medium">{h}</td>
                    <td className="px-3 py-2 text-muted">{parsedFile.rows[0]?.[h] || '—'}</td>
                    <td className="px-3 py-2">
                      <Select
                        value={importMapping.find(m => m.sourceColumn === h)?.targetField || 'ignore'}
                        options={[
                          { value: 'ignore', label: '— Р В�Р С–Р Р…Р С•РЎР‚Р С‘РЎР‚Р С•Р Р†Р В°РЎвЂљРЎРЉ —' },
                          ...IMPORTABLE_FIELDS.map(f => ({ value: f.key, label: `${f.label} ${f.required ? '*' : ''}` }))
                        ]}
                        onChange={(v) => updateMapping(h, v as any)}
                        className="w-full"
                      />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div className="mt-4 flex gap-2">
            <button type="button" onClick={() => { setImportStage('upload'); resetImport() }} className="rounded-xl border border-border bg-cardAlt/60 px-4 py-2.5 text-sm text-muted transition hover:text-text">{t.back}</button>
          </div>
        </div>
      )}

      {/* Stage 3: Preview */}
      {importStage === 'preview' && importPreview && (
        <div className="space-y-4">
          <div className="rounded-xl border border-border bg-card p-5 shadow-card">
            <div className="flex flex-wrap items-center justify-between gap-2 mb-4">
              <div>
                <div className="text-sm font-medium text-text">{t.preview}</div>
                <div className="text-xs text-muted">{t.previewHint}</div>
              </div>
              <div className="flex gap-2">
                <span className="inline-flex items-center gap-1 px-2 py-1 rounded text-xs bg-accent/15 text-accent">РІСљвЂњ {importPreview.validRows} РіРѕС‚РѕРІРѕ</span>
                <span className="inline-flex items-center gap-1 px-2 py-1 rounded text-xs bg-yellow-500/15 text-yellow-400">РІС™В  {importPreview.duplicateRows} Р Т‘СѓР±Р»РёРєР°С‚РѕРІ</span>
                <span className="inline-flex items-center gap-1 px-2 py-1 rounded text-xs bg-red-500/15 text-red-400">РІСљвЂ” {importPreview.errorRows} РѕС€РёР±РѕРє</span>
              </div>
            </div>

            <div className="overflow-x-auto max-h-[500px]">
              <table className="w-full min-w-[1000px] text-sm">
                <thead className="sticky top-0 bg-cardAlt/50 text-left text-xs text-muted">
                  <tr>
                    {parsedFile?.headers.map(h => (
                      <th key={h} className="px-2 py-2 font-medium">{h}</th>
                    ))}
                    <th className="px-3 py-2 font-medium">Р РЋРЎвЂљР В°РЎвЂљРЎС“РЎРѓ</th>
                    <th className="px-3 py-2 font-medium">Р”РµР№СЃС‚РІРёРµ</th>
                  </tr>
                </thead>
                <tbody>
                  {importPreview.rows.map((r, i) => {
                    const statusColor = r.isDuplicate ? 'bg-yellow-500/15 text-yellow-400' :
                      r.validation.isValid ? 'bg-accent/15 text-accent' : 'bg-red-500/15 text-red-400'
                    const statusText = r.isDuplicate ? 'Р”СѓР±Р»РёРєР°С‚' : r.validation.isValid ? 'Р“РѕС‚РѕРІРѕ' : 'Ошибка'
                    return (
                      <tr key={i} className="border-t border-border/70">
                        {parsedFile?.headers.map(h => (
                          <td key={h} className="px-2 py-2">
                            <input
                              value={r.raw[h] ?? ''}
                              onChange={(e) => {
                                const newRaw = { ...r.raw, [h]: e.target.value }
                                setImportPreview(prev => prev ? {
                                  ...prev,
                                  rows: prev.rows.map((row, idx) => idx === i ? { ...row, raw: newRaw } : row)
                                } : null)
                              }}
                              className="w-full min-w-[90px] rounded-lg border border-border bg-cardAlt/40 px-2 py-1.5 text-sm text-text outline-none focus:border-accent/40"
                            />
                          </td>
                        ))}
                        <td className="px-3 py-2">
                          <span className={`whitespace-nowrap rounded-full px-2 py-0.5 text-[11px] ${statusColor}`}>{statusText}</span>
                        </td>
                        <td className="px-3 py-2 text-center">
                          {!r.validation.isValid && (
                            <button
                              type="button"
                              onClick={() => {
                                const fixed = mapRowToTransaction(r.raw, importMapping, categories.map(c => ({ id: c.id, name: c.name })))
                                setImportPreview(prev => prev ? {
                                  ...prev,
                                  rows: prev.rows.map((row, idx) => idx === i ? fixed : row)
                                } : null)
                              }}
                              className="text-xs text-accent hover:underline"
                            >
                              Р В�РЎРѓР С—РЎР‚Р В°Р Р†Р С‘РЎвЂљРЎРЉ
                            </button>
                          )}
                        </td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>
          </div>

          <div className="flex gap-2 justify-end">
            <button type="button" onClick={() => setImportStage('mapping')} className="rounded-xl border border-border bg-cardAlt/60 px-4 py-2.5 text-sm text-muted transition hover:text-text">{t.back}</button>
            <button type="button" onClick={confirmImport} disabled={importPreview.validRows === 0} className="rounded-xl border border-accent/30 bg-accent/15 px-4 py-2 text-sm font-medium text-accent transition hover:bg-accent/20 disabled:opacity-40">{t.confirmImport}</button>
          </div>
        </div>
      )}

      {/* Stage 4: Confirm */}
      {importStage === 'confirm' && (
        <div className="rounded-xl border border-accent/20 bg-accent/10 p-5 text-center">
          <CheckCircle size={48} className="mx-auto text-accent mb-3" />
          <div className="text-lg font-medium text-text">Р В�РјРїРѕСЂС‚ Р·Р°РІРµСЂС€С‘РЅ</div>
          <div className="mt-1 text-sm text-muted">{importMsg}</div>
          <button type="button" onClick={() => { resetImport(); setImportMsg('') }} className="mt-4 inline-flex items-center gap-2 rounded-xl border border-accent/30 bg-accent/15 px-4 py-2.5 text-sm font-medium text-accent transition hover:bg-accent/20">
            <Upload size={16} /> Р—Р°РіСЂСѓР·РёС‚СЊ Р Т‘СЂСѓРіРѕР№ РЎвЂћР В°Р в„–Р В»
          </button>
        </div>
      )}
    </div>
  )

  // Selected row detail panel
  const DetailPanel = () => (
    <motion.div
      key="detail"
      initial={{ opacity: 0, x: 20 }}
      animate={{ opacity: 1, x: 0 }}
      exit={{ opacity: 0, x: 20 }}
      className="fixed inset-0 z-50 flex"
    >
      <div className="absolute inset-0 bg-black/50" onClick={() => setSelectedRow(null)} />
      <motion.div
        initial={{ opacity: 0, x: 50 }}
        animate={{ opacity: 1, x: 0 }}
        exit={{ opacity: 0, x: 50 }}
        className="w-full max-w-2xl h-full bg-card border-l border-border overflow-y-auto shadow-xl"
      >
        {selectedRow && (
          <>
            <div className="flex items-center justify-between border-b border-border p-4">
              <div>
                <div className="text-sm font-medium text-text">Р”РµС‚Р°Р»Рё РѕРїРµСЂР°С†РёРё</div>
                <div className="text-xs text-muted">ID: {selectedRow.id.slice(0, 8)}...</div>
              </div>
              <button onClick={() => setSelectedRow(null)} className="rounded-lg p-1.5 text-muted hover:bg-cardAlt hover:text-text"><X size={20} /></button>
            </div>
            <div className="p-4 space-y-4 max-h-[calc(100vh-120px)] overflow-y-auto">
              <DocumentManager transaction={selectedRow} onDocumentChange={loadData} />
              <div className="border-t border-border pt-4 space-y-3 text-sm">
                <div className="grid grid-cols-2 gap-2">
                  <div><span className="text-muted">Р СћР С‘Р С—:</span> <span className="ml-2 font-medium">{selectedRow.type === 'income' ? 'РІвЂ вЂ� Р СџРЎР‚Р С‘РЎвЂ¦Р С•Р Т‘' : 'РІвЂ вЂњ Р В Р В°РЎРѓРЎвЂ¦Р С•Р Т‘'}</span></div>
                  <div><span className="text-muted">Р РЋРЎС“Р С�Р С�Р В°:</span> <span className="ml-2 font-medium">{selectedRow.type === 'income' ? '+' : '-'}{formatCurrency(selectedRow.amount, currency, locale)}</span></div>
                  <div><span className="text-muted">РљР°С‚РµРіРѕСЂРёСЏ:</span> <span className="ml-2">{categories.find(c => c.id === selectedRow.category_id)?.name || selectedRow.category_id || '—'}</span></div>
                  <div><span className="text-muted">Р вЂќР В°РЎвЂљР В°:</span> <span className="ml-2">{formatDate(selectedRow.transaction_date, locale)}</span></div>
                  <div><span className="text-muted">РћС‚РїСЂР°РІРёС‚РµР»СЊ:</span> <span className="ml-2">{selectedRow.sender_name || '—'}</span></div>
                  <div><span className="text-muted">Р‘Р°РЅРє РѕС‚РїСЂР°РІРёС‚РµР»СЏ:</span> <span className="ml-2">{selectedRow.sender_bank || '—'}</span></div>
                  <div><span className="text-muted">Р РЋРЎвЂЎРЎвЂ�РЎвЂљ РѕС‚РїСЂР°РІРёС‚РµР»СЏ:</span> <span className="ml-2 font-mono">{selectedRow.sender_account_masked || '—'}</span></div>
                  <div><span className="text-muted">Р СџР С•Р В»РЎС“РЎвЂЎР В°РЎвЂљР ВµР В»РЎРЉ:</span> <span className="ml-2">{selectedRow.recipient_name || '—'}</span></div>
                  <div><span className="text-muted">Р‘Р°РЅРє РїРѕР»СѓС‡Р°С‚РµР»СЏ:</span> <span className="ml-2">{selectedRow.recipient_bank || '—'}</span></div>
                  <div><span className="text-muted">Р РЋРЎвЂЎРЎвЂ�РЎвЂљ РїРѕР»СѓС‡Р°С‚РµР»СЏ:</span> <span className="ml-2 font-mono">{selectedRow.recipient_account_masked || '—'}</span></div>
                  <div><span className="text-muted">Р В�РЎРѓРЎвЂљР С•РЎвЂЎР Р…Р С‘Р С”:</span> <span className="ml-2">{selectedRow.source_type ? SOURCE_TYPE_OPTIONS.find(o => o.value === selectedRow.source_type)?.label : '—'}</span></div>
                  <div><span className="text-muted">Способ оплаты способа оплаты:</span> <span className="ml-2">{selectedRow.payment_method ? PAYMENT_METHOD_OPTIONS.find(o => o.value === selectedRow.payment_method)?.label : '—'}</span></div>
                  <div><span className="text-muted">ID Р±Р°РЅРє. РѕРїРµСЂР°С†РёРё:</span> <span className="ml-2 font-mono">{selectedRow.bank_transaction_id || '—'}</span></div>
                  <div><span className="text-muted">РљРѕРјРјРµРЅС‚Р°СЂРёР№:</span> <span className="ml-2">{selectedRow.comment || '—'}</span></div>
                  <div className="col-span-2"><span className="text-muted">РћРїРёСЃР°РЅРёРµ:</span> <div className="mt-1">{selectedRow.description || '—'}</div></div>
                </div>
              </div>
            </div>
          </>
        )}
      </motion.div>
    </motion.div>
  )

  return (
    <div className="space-y-4">
      <div className="flex flex-wrap gap-1 bg-card/50 rounded-xl p-1" role="tablist">
        {tabs.map((tab) => {
          const Icon = tab.icon
          const isActive = activeTab === tab.id
          return (
            <button
              key={tab.id}
              type="button"
              role="tab"
              aria-selected={isActive}
              onClick={() => setActiveTab(tab.id)}
              className={`flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium transition ${
                isActive ? 'bg-accent/15 text-accent' : 'text-muted hover:text-text/90 hover:bg-cardAlt/50'
              }`}
            >
              <Icon size={16} />
              {tab.label}
            </button>
          )
        })}
      </div>

      <AnimatePresence>
        {activeTab === 'list' && <motion.div key="list" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}><ListTab /></motion.div>}
        {activeTab === 'add' && (
          <motion.div key="add" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}>
            <AddTab
              addForm={addForm}
              setAddForm={setAddForm}
              addErrors={addErrors}
              setAddErrors={setAddErrors}
              categories={categories}
              handleAddSubmit={handleAddSubmit}
              handleAddAndAnother={handleAddAndAnother}
              validateForm={validateForm}
              t={t}
              saving={addSaving}
              feedback={addFeedback}
            />
          </motion.div>
        )}
        {activeTab === 'import' && <motion.div key="import" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}><ImportTab /></motion.div>}
      </AnimatePresence>

      {showAddModal && (
        <Modal open={true} title="Р”РѕР±Р°РІРёС‚СЊ РѕРїРµСЂР°С†РёСЋ" onClose={() => !addSaving && setShowAddModal(false)} wide>
          <AddTab
            addForm={addForm}
            setAddForm={setAddForm}
            addErrors={addErrors}
            setAddErrors={setAddErrors}
            categories={categories}
            handleAddSubmit={handleAddSubmit}
            handleAddAndAnother={handleAddAndAnother}
            validateForm={validateForm}
            t={t}
            saving={addSaving}
            feedback={addFeedback}
          />
        </Modal>
      )}

      {selectedRow && <DetailPanel />}
    </div>
  )
}

