{
  "name": "charity-finance-app",
  "version": "0.1.0",
  "private": true,
  "description": "Premium financial management desktop application for a charitable foundation",
  "main": "./out/main/index.js",
  "author": "Foundation",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "preview": "node scripts/preview.mjs",
    "sber:check": "npm run build && node scripts/sber-check.mjs",
    "sber:test": "npm run build && node scripts/sber-normalize-test.mjs && node scripts/sber-oauth-test.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "sber:auto-sync": "node scripts/sber-auto-sync.mjs",
    "sber:sync-once": "node scripts/sber-auto-sync.mjs --once",
    "sber:prepare-secret": "node scripts/prepare-sber-bundle.mjs",
    "build:site": "node scripts/build-protected-site.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "framer-motion": "^11.11.17",
    "lenis": "^1.3.28",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "html-minifier-terser": "^7.2.0",
    "javascript-obfuscator": "^5.10.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
