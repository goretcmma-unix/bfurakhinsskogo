# Supabase (public client config). Не используйте префикс VITE_ для секретных ключей.
VITE_SUPABASE_URL=https://ybgxfewbhjvtgdklzihr.supabase.co
VITE_SUPABASE_ANON_KEY=<anon_public_key>

# Серверный ключ Supabase для Electron main process (Sber sync → запись в public.transactions).
# Используется только в main process, НЕ передавать в renderer/клиентскую часть. Без префикса VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# =============================================================================
# SBER API — интеграция (модуль electron/sber-api)
# =============================================================================
# ВАЖНО: этот файл — образец. Реальные значения кладите в .env (он в .gitignore).
# Секреты не печатаются в лог и не передаются в React-интерфейс.
#
# Пометки:
#   [ДОК]  — параметр и его назначение подтверждены документацией developers.sber.ru
#   [ВАШИ] — значение выдаёт вам Sber для вашего продукта; взять из личного кабинета
#            или спецификации/поддержки. В коде НЕ подставлено угадыванием.
# =============================================================================

# Окружение: sandbox (тестовый контур) или production (промышленный контур).
# Для промышленной интеграции укажите production и заполните SBER_PRODUCTION_*.
SBER_API_ENV=sandbox

# [ВАШИ] Идентификатор приложения (client_id), выданный при регистрации приложения.
SBER_CLIENT_ID=

# [ВАШИ] Client secret — нужен только если ваш продукт использует
# confidential-клиент. Если приложение публичное/mTLS-only — оставьте пустым.
SBER_CLIENT_SECRET=

# [ДОК] Redirect URI, указанный при регистрации приложения. Используется в ссылке
#       авторизации (параметр redirect_uri).
SBER_REDIRECT_URI=http://localhost:5173/sber/callback

# [ДОК] Scopes подтверждены документацией Сбера:
#       GET_STATEMENT_ACCOUNT     — выписка по счёту
#       GET_STATEMENT_TRANSACTION — выписка по транзакциям
SBER_SCOPES=GET_STATEMENT_ACCOUNT GET_STATEMENT_TRANSACTION

# -----------------------------------------------------------------------------
# mTLS — клиентский сертификат
# -----------------------------------------------------------------------------
# [ВАШИ] Путь к PKCS#12 (.p12/.pfx), выданному Sber для выбранного окружения.
#        Для production используйте промышленный TLS-сертификат (отдельно от sandbox).
#        Храните файл ВНЕ проекта.
SBER_P12_PATH=

# [ВАШИ] Пароль от .p12. Хранится только в .env, в лог не попадает.
SBER_P12_PASSWORD=

# [ВАШИ, необязательно] CA-сертификат Sber (PEM), если требуется цепочка
#                      доверия, отличная от системной.
SBER_CA_PATH=

# [ДОК, отладка] Отключить проверку серверного сертификата. По умолчанию false.
SBER_ALLOW_INVALID_SERVER_CERT=false

# -----------------------------------------------------------------------------
# Адреса Sandbox (тестовый контур)
# -----------------------------------------------------------------------------
# Base URL Sandbox — корень API (проверка доступности и mTLS).
# Источник: официальная коллекция Postman Sber
SBER_SANDBOX_BASE_URL=https://fintech-test.sberbank.ru:9443

# URL получения/обновления OAuth-токена (Sandbox).
SBER_SANDBOX_TOKEN_URL=https://fintech-test.sberbank.ru:9443/ic/sso/api/oauth/token

# Методы выписок (Sandbox). Путь подставляется к SBER_SANDBOX_BASE_URL.
SBER_SANDBOX_STATEMENT_ACCOUNT_PATH=/fintech/api/v2/statement/summary
SBER_SANDBOX_STATEMENT_TRANSACTION_PATH=/fintech/api/v2/statement/transactions

# -----------------------------------------------------------------------------
# Адреса Production (промышленный контур)
# -----------------------------------------------------------------------------
# По инструкции Sber API:
#   - Авторизация через СберБизнес ID: https://sbi.sberbank.ru:9443
#   - Отправка API запросов:          https://fintech.sberbank.ru:9443
#   - Вход в СберБизнес:              https://sbi.sberbank.ru:9443/ic/ufs/login.html
# Точные token/statement пути и настройки (client_id/secret, redirect_uri, scope)
# берутся из Личного кабинета Sber API или от технической поддержки.
SBER_PRODUCTION_BASE_URL=https://fintech.sberbank.ru:9443
SBER_PRODUCTION_TOKEN_URL=
SBER_PRODUCTION_STATEMENT_ACCOUNT_PATH=
SBER_PRODUCTION_STATEMENT_TRANSACTION_PATH=

# [ВАШИ] Номер счёта для получения выписки. Можно задать общий SBER_ACCOUNT_NUMBER
#        или раздельно для окружений.
SBER_ACCOUNT_NUMBER=
SBER_SANDBOX_ACCOUNT_NUMBER=
SBER_PRODUCTION_ACCOUNT_NUMBER=

# [ВАШИ] Дата выписки (YYYY-MM-DD). Если не задана — берётся скользящее окно (последние 7 дней).
#        Для одной даты используется statementDate (по умолчанию); для периода задайте
#        SBER_STATEMENT_USE_PERIOD=true и передавайте from/to.
SBER_STATEMENT_DATE=
SBER_STATEMENT_USE_PERIOD=false

# [ВАШИ] Если ваш токен-endpoint ждёт другой grant_type — укажите его здесь.
#        По умолчанию: refresh_token
SBER_TOKEN_GRANT_TYPE=refresh_token

# [ВАШИ] Формат тела запроса токена: form (application/x-www-form-urlencoded) или json
SBER_TOKEN_BODY_FORMAT=form

# Метод выписок: GET или POST (по спецификации продукта)
SBER_STATEMENT_METHOD=GET

# [ДОК] URL страницы авторизации Sber — нужен только если ваш продукт
#       использует authorization code flow (ссылка генерируется модулем).
#       Примеры базовых адресов: sandbox — из настроек продукта; production — https://sbi.sberbank.ru:9443
SBER_AUTHORIZE_URL=

# -----------------------------------------------------------------------------
# Защищённое хранилище токенов
# -----------------------------------------------------------------------------
# Парольная фраза для шифрования tokens.json (AES-256-GCM).
# Если пусто — токены хранятся только в памяти процесса.
# Придумайте свой: это НЕ пароль от .p12.
SBER_STORE_PASSPHRASE=

# Смещение часового пояса, в котором банк показывает время в ЛК, в минутах от UTC.
# По умолчанию 180 (UTC+3, Москва). Используется при разборе даты истечения токена.
SBER_TIMEZONE_OFFSET=180

# Интервал фоновой автосинхронизации Sber → transactions, в минутах.
# По умолчанию (если не задано) = 30: при запуске приложения и далее периодически
# выписка автоматически записывается в БД (без ручной кнопки). Укажите 0, чтобы отключить.
SBER_AUTO_SYNC_MINUTES=

# LK-issued tokens (optional, server-side only)
SBER_ACCESS_TOKEN=
SBER_REFRESH_TOKEN=
SBER_TOKEN_EXPIRES_IN=3600
